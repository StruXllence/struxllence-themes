    "editorSuggestWidget.highlightForeground": "#FFA726",
    "editorSuggestWidget.selectedBackground": "#282A33",
    "peekView.border": "#F57C00",
    "peekViewEditor.background": "#131418",
    "peekViewResult.background": "#1A1B20",
    "peekViewResult.selectionBackground": "#282A33",
    "peekViewTitle.background": "#1A1B20",
    "panel.background": "#141518",
    "panel.border": "#1E2026",
    "panelTitle.activeBorder": "#F57C00",
    "panelTitle.activeForeground": "#FFFFFF",
    "panelTitle.inactiveForeground": "#6B7280",
    "statusBar.background": "#111215",
    "statusBar.foreground": "#E7E7E7",
    "statusBar.border": "#1E2026",
    "statusBar.debuggingBackground": "#F57C00",
    "statusBar.debuggingForeground": "#111215",
    "statusBar.noFolderBackground": "#111215",
    "statusBarItem.activeBackground": "#282A33",
    "statusBarItem.hoverBackground": "#1F2128",
    "statusBarItem.remoteBackground": "#F57C00",
    "statusBarItem.remoteForeground": "#111215",
    "titleBar.activeBackground": "#111215",
    "titleBar.activeForeground": "#E7E7E7",
    "titleBar.inactiveBackground": "#111215",
    "titleBar.inactiveForeground": "#6B7280",
    "titleBar.border": "#1E2026",
    "terminal.background": "#131417",
    "terminal.foreground": "#E7E7E7",
    "terminal.ansiBlack": "#1E1E1E",
    "terminal.ansiRed": "#EF6B73",
    "terminal.ansiGreen": "#4DBD90",
    "terminal.ansiYellow": "#ECAA55",
    "terminal.ansiBlue": "#6BB5F5",
    "terminal.ansiMagenta": "#C89BF0",
    "terminal.ansiCyan": "#4EC9C1",
    "terminal.ansiWhite": "#D6DBE4",
    "terminal.ansiBrightBlack": "#8B949E",
    "terminal.ansiBrightRed": "#FF8A92",
    "terminal.ansiBrightGreen": "#6DD6A8",
    "terminal.ansiBrightYellow": "#FFD180",
    "terminal.ansiBrightBlue": "#8BC8FF",
    "terminal.ansiBrightMagenta": "#DCB5FF",
    "terminal.ansiBrightCyan": "#7EDCD6",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "breadcrumb.foreground": "#9CA3AF",
    "breadcrumb.focusForeground": "#FFA726",
    "breadcrumb.activeSelectionForeground": "#FFFFFF",
    "breadcrumbPicker.background": "#1A1B20",
    "gitDecoration.modifiedResourceForeground": "#F5A34A",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#4DBD90",
    "gitDecoration.ignoredResourceForeground": "#4B5563",
    "gitDecoration.conflictingResourceForeground": "#F43F5E",
    "button.background": "#F57C00",
    "button.foreground": "#111215",
    "button.hoverBackground": "#FFA726",
    "button.secondaryBackground": "#282A33",
    "button.secondaryForeground": "#E7E7E7",
    "input.background": "#121316",
    "input.border": "#374151",
    "input.foreground": "#FFFFFF",
    "input.placeholderForeground": "#6B7280",
    "inputOption.activeBorder": "#F57C00",
    "dropdown.background": "#1A1B20",
    "dropdown.border": "#374151",
    "dropdown.foreground": "#E7E7E7",
    "badge.background": "#F57C00",
    "badge.foreground": "#111215",
    "progressBar.background": "#F57C00",
    "scrollbarSlider.background": "#6B728022",
    "scrollbarSlider.hoverBackground": "#6B728044",
    "scrollbarSlider.activeBackground": "#F57C0088",
    "terminalCursor.foreground": "#F57C00",
    "terminalCursor.background": "#131417",
    "terminal.selectionBackground": "#F57C0038",
    "terminal.inactiveSelectionBackground": "#F57C0020",
    "terminal.selectionForeground": "#E7E7E7",
    "terminal.findMatchBackground": "#F57C0055",
    "terminal.findMatchHighlightBackground": "#F57C0026",
    "terminal.findMatchBorder": "#FFA726",
    "diffEditor.insertedTextBackground": "#2DAE7026",
    "diffEditor.removedTextBackground": "#EF6B7326",
    "diffEditor.insertedLineBackground": "#2DAE7014",
    "diffEditor.removedLineBackground": "#EF6B7314",
    "diffEditor.border": "#30343D",
    "diffEditor.diagonalFill": "#5D6472",
    "diffEditorGutter.insertedLineBackground": "#4DBD9040",
    "diffEditorGutter.removedLineBackground": "#F8717140",
    "diffEditorOverview.insertedForeground": "#4DBD9099",
    "diffEditorOverview.removedForeground": "#F8717199",
    "editorOverviewRuler.addedForeground": "#4DBD90",
    "editorOverviewRuler.modifiedForeground": "#F5A34A",
    "editorOverviewRuler.deletedForeground": "#F87171",
    "minimapGutter.addedBackground": "#4DBD90",
    "minimapGutter.modifiedBackground": "#F5A34A",
    "minimapGutter.deletedBackground": "#F87171",
    "gitDecoration.addedResourceForeground": "#4DBD90",
    "gitDecoration.stageModifiedResourceForeground": "#F5A34A",
    "gitDecoration.stageDeletedResourceForeground": "#F87171"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9AA3B1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F57C00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFD180"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#64B5F6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings & Characters",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#81C784"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "name": "Constants & Enums",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FF9800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other"
      ],
      "settings": {
        "foreground": "#E7E7E7"
      }
    },
    {
      "name": "Object & Property Keys",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E0E0E0"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F57C00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#90CAF9"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#E7E7E7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFD180",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.raw.inline",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#81C784"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#64B5F6"
      }
    },
    {
      "name": "Namespaces & modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#64B5F6"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#FF9800"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#81C784"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#81C784"
      }
    },
    {
      "name": "Diff removals",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FFA726"
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FF9800"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "type": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "class": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "enum": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "interface": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "struct": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#64B5F6",
      "bold": true
    },
    "parameter": "#E7E7E7",
    "variable": "#E7E7E7",
    "label": "#E7E7E7",
    "property": "#E0E0E0",
    "event": "#E0E0E0",
    "function": "#FFD180",
    "method": "#FFD180",
    "macro": "#FFD180",
    "enumMember": {
      "foreground": "#FF9800",
      "bold": true
    },
    "decorator": "#90CAF9",
    "comment": {
      "foreground": "#9AA3B1",
      "italic": true
    },
    "string": "#81C784",
    "keyword": {
      "foreground": "#F57C00",
      "bold": true
    },
    "number": "#FFA726",
    "regexp": "#81C784",
    "operator": "#FFA726",
    "variable.readonly": {
      "foreground": "#FF9800",
      "bold": true
    },
    "property.readonly": {
      "foreground": "#FF9800",
      "bold": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
