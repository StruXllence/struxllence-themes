{
  "$schema": "vscode://schemas/color-theme",
  "name": "StruXllence Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#D96B00",
    "foreground": "#1E1E1E",
    "widget.shadow": "#00000022",
    "selection.background": "#F57C0033",
    "descriptionForeground": "#5A6270",
    "errorForeground": "#DC2626",
    "icon.foreground": "#374151",

    "activityBar.background": "#ECEEF1",
    "activityBar.foreground": "#D96B00",
    "activityBar.inactiveForeground": "#6B7280",
    "activityBar.border": "#D1D5DB",
    "activityBarBadge.background": "#D96B00",
    "activityBarBadge.foreground": "#FFFFFF",

    "sideBar.background": "#F3F4F6",
    "sideBar.foreground": "#1E1E1E",
    "sideBar.border": "#E5E7EB",
    "sideBarTitle.foreground": "#111827",
    "sideBarSectionHeader.background": "#E5E7EB",
    "sideBarSectionHeader.foreground": "#B45309",
    "sideBarSectionHeader.border": "#D1D5DB",

    "editorGroupHeader.tabsBackground": "#E5E7EB",
    "editorGroupHeader.tabsBorder": "#D1D5DB",
    "tab.activeBackground": "#F9FAFB",
    "tab.activeForeground": "#111827",
    "tab.activeBorder": "#D96B00",
    "tab.activeBorderTop": "#D96B00",
    "tab.inactiveBackground": "#E5E7EB",
    "tab.inactiveForeground": "#6B7280",
    "tab.border": "#D1D5DB",
    "tab.hoverBackground": "#F3F4F6",

    "editor.background": "#F9FAFB",
    "editor.foreground": "#1F2937",
    "editorLineNumber.foreground": "#9CA3AF",
    "editorLineNumber.activeForeground": "#D96B00",
    "editorCursor.foreground": "#D96B00",
    "editor.selectionBackground": "#F57C002A",
    "editor.inactiveSelectionBackground": "#F57C0018",
    "editor.selectionHighlightBackground": "#F57C0020",
    "editor.wordHighlightBackground": "#F57C0025",
    "editor.wordHighlightStrongBackground": "#F57C0035",
    "editor.findMatchBackground": "#F57C0055",
    "editor.findMatchHighlightBackground": "#F57C0028",
    "editor.lineHighlightBackground": "#F3F4F6",
    "editor.lineHighlightBorder": "#E5E7EB",
    "editorWhitespace.foreground": "#D1D5DB",
    "editorIndentGuide.background": "#E5E7EB",
    "editorIndentGuide.activeBackground": "#D96B0077",
    "editorRuler.foreground": "#E5E7EB",
    "editorBracketMatch.background": "#F57C0025",
    "editorBracketMatch.border": "#D96B00",

    "editorGutter.background": "#F9FAFB",
    "editorGutter.addedBackground": "#059669",
    "editorGutter.modifiedBackground": "#D96B00",
    "editorGutter.deletedBackground": "#DC2626",

    "editorOverviewRuler.border": "#E5E7EB",
    "editorOverviewRuler.findMatchForeground": "#D96B00aa",
    "editorOverviewRuler.errorForeground": "#DC2626",
    "editorOverviewRuler.warningForeground": "#D96B00",
    "editorOverviewRuler.infoForeground": "#0284C7",

    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#D96B0066",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.border": "#D1D5DB",
    "editorSuggestWidget.foreground": "#1F2937",
    "editorSuggestWidget.highlightForeground": "#D96B00",
    "editorSuggestWidget.selectedBackground": "#F3F4F6",

    "peekView.border": "#D96B00",
    "peekViewEditor.background": "#FFFFFF",
    "peekViewResult.background": "#F3F4F6",
    "peekViewResult.selectionBackground": "#E5E7EB",
    "peekViewTitle.background": "#E5E7EB",

    "panel.background": "#F3F4F6",
    "panel.border": "#E5E7EB",
    "panelTitle.activeBorder": "#D96B00",
    "panelTitle.activeForeground": "#111827",
    "panelTitle.inactiveForeground": "#6B7280",

    "statusBar.background": "#ECEEF1",
    "statusBar.foreground": "#374151",
    "statusBar.border": "#D1D5DB",
    "statusBar.debuggingBackground": "#D96B00",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#ECEEF1",
    "statusBarItem.activeBackground": "#D1D5DB",
    "statusBarItem.hoverBackground": "#E5E7EB",
    "statusBarItem.remoteBackground": "#D96B00",
    "statusBarItem.remoteForeground": "#FFFFFF",

    "titleBar.activeBackground": "#ECEEF1",
    "titleBar.activeForeground": "#1F2937",
    "titleBar.inactiveBackground": "#ECEEF1",
    "titleBar.inactiveForeground": "#6B7280",
    "titleBar.border": "#D1D5DB",

    "terminal.background": "#F9FAFB",
    "terminal.foreground": "#1F2937",
    "terminal.ansiBlack": "#1F2937",
    "terminal.ansiRed": "#DC2626",
    "terminal.ansiGreen": "#059669",
    "terminal.ansiYellow": "#D96B00",
    "terminal.ansiBlue": "#0284C7",
    "terminal.ansiMagenta": "#9333EA",
    "terminal.ansiCyan": "#0D9488",
    "terminal.ansiWhite": "#E5E7EB",
    "terminal.ansiBrightBlack": "#4B5563",
    "terminal.ansiBrightRed": "#EF4444",
    "terminal.ansiBrightGreen": "#10B981",
    "terminal.ansiBrightYellow": "#F57C00",
    "terminal.ansiBrightBlue": "#38BDF8",
    "terminal.ansiBrightMagenta": "#A855F7",
    "terminal.ansiBrightCyan": "#14B8A6",
    "terminal.ansiBrightWhite": "#111827",

    "breadcrumb.foreground": "#6B7280",
    "breadcrumb.focusForeground": "#D96B00",
    "breadcrumb.activeSelectionForeground": "#111827",
    "breadcrumbPicker.background": "#FFFFFF",

    "gitDecoration.modifiedResourceForeground": "#D96B00",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#9CA3AF",
    "gitDecoration.conflictingResourceForeground": "#E11D48",

    "button.background": "#D96B00",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#B45309",
    "button.secondaryBackground": "#E5E7EB",
    "button.secondaryForeground": "#1F2937",

    "input.background": "#FFFFFF",
    "input.border": "#D1D5DB",
    "input.foreground": "#111827",
    "input.placeholderForeground": "#9CA3AF",
    "inputOption.activeBorder": "#D96B00",

    "dropdown.background": "#FFFFFF",
    "dropdown.border": "#D1D5DB",
    "dropdown.foreground": "#1F2937",

    "badge.background": "#D96B00",
    "badge.foreground": "#FFFFFF",

    "progressBar.background": "#D96B00",
    "scrollbarSlider.background": "#4B55631A",
    "scrollbarSlider.hoverBackground": "#4B556333",
    "scrollbarSlider.activeBackground": "#D96B0066"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6B7280",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#D96B00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": {
        "foreground": "#B45309"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"],
      "settings": {
        "foreground": "#0284C7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings & Characters",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "Constants & Enums",
      "scope": ["constant", "constant.other", "variable.other.constant"],
      "settings": {
        "foreground": "#D96B00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#1F2937"
      }
    },
    {
      "name": "Object & Property Keys",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": {
        "foreground": "#374151"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#D96B00"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#D96B00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#0284C7"
      }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#1F2937",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.raw.inline", "markup.raw.block"],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#0284C7"
      }
    }
  ]
}

